            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-maxavans-5101782.webp" alt="Debt collection" loading="lazy" />
            <div class="card-content text-white">
              <h1 class="card-title">Debt collection</h1>
              <a class="card-btn" href={`${enBaseUrl}expertise/recouvrement-creances/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-8">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-jan-van-der-wolf-11680885-29891328.webp" alt="Sale of business assets" loading="lazy" />
            <div class="card-content text-primary">
              <h1 class="card-title">Sale of business assets</h1>
              <a class="card-btn" href={`${enBaseUrl}expertise/cession-fonds-de-commerce/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-9">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-bingqian-li-230971044-31589565.webp" alt="Contract negotiation" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Contract negotiation</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/negociation-contractuelle/`}><span>Learn more</span></a>
            </div>
          </div>
