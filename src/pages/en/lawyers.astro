---
// src/pages/vos-avocats.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// URL de base pour la version anglaise
const enBaseUrl = `${baseUrl}en/`;

const pageTitle = "Vos avocats - Sprauer Avocats Paris";
const pageDescription = "Les associés du cabinet mettent leur expertise et leur engagement au service de la défense de vos intérêts en droit des affaires et droit pénal.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <!-- HERO SECTION -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <h1><span>Your</span> Lawyers</h1>
          <p>
            The firm's partners put their expertise and commitment at the service of defending your interests.<br /><br />
            Each of them practices in complex legal fields requiring rigor, responsiveness, and excellence, in keeping with the firm's values.
          </p>
        </div>
        <div class="hero-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/justice-2060093.webp" 
            alt="Statue of Justice" 
            width="700" 
            height="700"
          />
        </div>
      </div>
    </section>

    <!-- VINCENT SPRAUER SECTION -->
    <section class="lawyer-section vincent" id="vincent-sprauer">
      <div class="container lawyer-grid">
        <div class="lawyer-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/vincent-sprauer.webp" 
            alt="Maître Vincent Sprauer - Lawyer in Paris" 
            width="500" 
            height="750"
          />
        </div>
        <div class="lawyer-content">
          <div class="lawyer-title">
            <span class="triangle-icon">▲</span>
            <h2>Vincent <span>Sprauer</span></h2>
          </div>
          <p class="subtitle">Attorney registered at the Paris Bar since 2019.</p>
          <div class="bio">
            <p>
              With dual expertise in private law and applied foreign languages, Maître SPRAUER graduated from Paris 1 Panthéon-Sorbonne University.
            </p>
            <p>
              Since 2019, he has built solid experience within renowned Parisian law firms, distinguishing himself in complex cases in criminal law and business law.
            </p>
            <p>
              His expertise extends to defending accounting professionals and supporting a diverse clientele in civil, commercial, and criminal matters.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- MÉLANIE MIROITE SECTION -->
    <section class="lawyer-section melanie" id="melanie-miroite">
      <div class="container lawyer-grid reverse">
        <div class="lawyer-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/melanie-miroite.webp" 
            alt="Maître Mélanie Miroite - Lawyer in Paris" 
            width="500" 
            height="750"
          />
        </div>
        <div class="lawyer-content">
          <div class="lawyer-title">
            <span class="triangle-icon">▲</span>
            <h2>Mélanie Miroite</h2>
          </div>
          <div class="bio">
            <p>
              Holding a Master 2 degree in Civil and Commercial Obligations Law from Paris Descartes University, Maître MIROITE has over the years acquired specialized knowledge in asylum law and immigration law.
            </p>
            <p>
              Today, Maître MIROITE pleads daily before the National Court of Asylum located in MONTREUIL, enabling her to provide her clients with optimal counsel regarding the procedure and specific expectations of this jurisdiction.
            </p>
            <p>
              Maître MIROITE is also actively involved in community organizations assisting with the welcoming and integration of foreign nationals in France.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* HERO SECTION */
  .hero {
    padding: 80px 0;
    background-color: var(--color-primary);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-content h1 {
    font-size: 2.6rem;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1.1;
  }

  .hero-content h1 span {
    color: var(--color-accent);
  }

  .hero-content p {
    margin-top: 20px;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .hero-image img {
    border-radius: 8px;
    object-fit: contain;
    width: 100%;
    height: auto;
  }

  /* SECTIONS AVOCATS */
  .lawyer-section {
    padding: 90px 0;
  }

  .lawyer-section.vincent {
    background-color: var(--color-neutral);
    color: var(--color-primary);
  }

  .lawyer-section.melanie {
    background-color: var(--color-primary-extralight);
    color: var(--color-primary);
  }

  .lawyer-grid {
    display: flex;
    align-items: center;
    gap: 60px;
  }

  .lawyer-grid.reverse {
    flex-direction: row-reverse;
  }

  .lawyer-image {
    flex: 1;
    max-width: 440px;
  }

  .lawyer-image img {
    width: 100%;
    height: 550px;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .lawyer-content {
    flex: 1.2;
  }

  .lawyer-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .lawyer-title h2 {
    font-size: 2.25rem;
    font-weight: 600;
  }

  .triangle-icon {
    color: var(--color-accent);
    font-size: 0.8rem;
    transform: rotate(90deg);
  }

  .melanie .triangle-icon {
    color: var(--color-primary);
  }

  .subtitle {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 20px;
  }

  .bio p {
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .bio p:last-child {
    margin-bottom: 0;
  }

  /* RESPONSIVE TABLETTE & MOBILE */
  @media (max-width: 991px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .lawyer-grid,
    .lawyer-grid.reverse {
      flex-direction: column;
      text-align: center;
      gap: 40px;
    }

    .lawyer-image {
      max-width: 100%;
    }

    .lawyer-image img {
      height: 450px;
    }

    .lawyer-title {
      justify-content: center;
    }
  }

  @media (max-width: 575px) {
    .hero {
      padding: 50px 0;
    }

    .lawyer-section {
      padding: 60px 0;
    }

    .hero-content h1 {
      font-size: 2rem;
    }

    .lawyer-title h2 {
      font-size: 1.8rem;
    }

    .lawyer-image img {
      height: 380px;
    }
  }
</style>