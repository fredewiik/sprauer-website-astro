---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Accueil - Sprauer Avocats Paris", 
  description = "Spécialisé en droit des affaires et en droit pénal, notre cabinet vous offre une expertise pointue et un accompagnement personnalisé." 
} = Astro.props;

// Normalisation de baseUrl pour les ressources statiques
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const faviconUrl = `${baseUrl}cropped-favicon-32x32.webp`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://sprauer.fr');

// Détection de la langue courante
const pathname = new URL(Astro.request.url).pathname;
const isEn = pathname.startsWith(`${baseUrl}en/`) || pathname === `${baseUrl}en`;
---

<!DOCTYPE html>
<html lang={isEn ? 'en' : 'fr-FR'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/webp" href={faviconUrl} />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Sprauer Avocats Paris" />

  <!-- Schema.org JSON-LD (SEO Avocat) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LegalService",
      "name": "Sprauer Avocats Paris",
      "url": "https://sprauer.fr/",
      "logo": "https://sprauer.fr/wp-content/uploads/2024/07/logo.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "43, boulevard Haussmann",
        "addressLocality": "Paris",
        "postalCode": "75009",
        "addressCountry": "FR"
      },
      "telephone": "01 40 36 74 87"
    }
  </script>
</head>
<body>
  <div class="top-scroll-gradient" aria-hidden="true"></div>
  <Header />
  <slot />
  <Footer />

  <CookieConsent />
</body>
</html>