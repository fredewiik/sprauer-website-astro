---
// src/components/Header.astro
const pathname = new URL(Astro.request.url).pathname;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// Détection de la langue courante
const isEn = pathname.startsWith(`${baseUrl}en/`) || pathname === `${baseUrl}en`;

// ---------------------------------------------------------------
// DICTIONNAIRE DE CORRESPONDANCE DES ROUTES (FR <-> EN)
// ---------------------------------------------------------------
// Clé = Chemin relatif FR | Valeur = Chemin relatif EN
const routesMap: Record<string, string> = {
  '': 'en/',
  'competences/': 'en/expertise/',
  'vos-avocats/': 'en/lawyers/',
  'parlons-droit/': 'en/insights/',
  'contact/': 'en/contact/',
  'mentions-legales/': 'en/legal-notice/',
};

// Dictionnaire inverse (EN -> FR)
const inverseRoutesMap = Object.fromEntries(
  Object.entries(routesMap).map(([fr, en]) => [en, fr])
);

// Extraire le chemin relatif par rapport au baseUrl
let currentRelativePath = pathname.startsWith(baseUrl)
  ? pathname.substring(baseUrl.length)
  : pathname;

// S'assurer qu'il y a un trailing slash si ce n'est pas la racine
if (currentRelativePath && !currentRelativePath.endsWith('/')) {
  currentRelativePath += '/';
}

let frPath = baseUrl;
let enPath = `${baseUrl}en/`;

if (isEn) {
  enPath = pathname;
  // Cherche la correspondance FR dans le dictionnaire
  const matchedFr = inverseRoutesMap[currentRelativePath];
  if (matchedFr !== undefined) {
    frPath = `${baseUrl}${matchedFr}`;
  } else if (currentRelativePath.startsWith('en/expertise/')) {
    // Fallback pour les sous-pages de compétences : redirige vers la liste des compétences FR
    frPath = `${baseUrl}competences/`;
  } else if (currentRelativePath.startsWith('en/insights/')) {
    // Fallback pour les sous-pages d'articles : redirige vers le blog FR
    frPath = `${baseUrl}parlons-droit/`;
  }
} else {
  frPath = pathname;
  // Cherche la correspondance EN dans le dictionnaire
  const matchedEn = routesMap[currentRelativePath];
  if (matchedEn !== undefined) {
    enPath = `${baseUrl}${matchedEn}`;
  } else if (currentRelativePath.startsWith('competences/')) {
    // Fallback pour les sous-pages de compétences : redirige vers la liste des compétences EN
    enPath = `${baseUrl}en/expertise/`;
  } else if (currentRelativePath.startsWith('parlons-droit/')) {
    // Fallback pour les sous-pages d'articles : redirige vers le blog EN
    enPath = `${baseUrl}en/insights/`;
  }
}

// Menus de navigation
const navItems = isEn 
  ? [
      { name: 'HOME', path: 'en/' },
      { name: 'EXPERTISE', path: 'en/expertise/' },
      { name: 'LAWYERS', path: 'en/lawyers/' },
      { name: 'INSIGHTS', path: 'en/insights/' },
      { name: 'CONTACT', path: 'en/contact/' },
    ]
  : [
      { name: 'ACCUEIL', path: '' },
      { name: 'COMPETENCES', path: 'competences/' },
      { name: 'VOS AVOCATS', path: 'vos-avocats/' },
      { name: 'PARLONS DROIT', path: 'parlons-droit/' },
      { name: 'CONTACT', path: 'contact/' },
    ];
---

<header class="header">
  <div class="container header-container">
    <!-- Logo -->
    <a href={isEn ? `${baseUrl}en/` : baseUrl} class="logo-link">
      <img 
        src="https://front.sprauer.fr/wp-content/uploads/2025/08/logo-h-blanc.webp" 
        alt="Sprauer Avocats Logo" 
        width="180" 
        height="50"
      />
    </a>

    <!-- Bouton Burger (Mobile) -->
    <button class="menu-toggle" id="menu-toggle" aria-label="Ouvrir le menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Navigation -->
    <nav class="nav" id="nav-menu">
      <ul class="nav-list">
        {navItems.map((item) => {
          const fullHref = `${baseUrl}${item.path}`;
          const isActive = item.path === '' || item.path === 'en/'
            ? (pathname === fullHref || pathname === `${fullHref}index.html`)
            : pathname.startsWith(fullHref);

          return (
            <li>
              <a href={fullHref} class={isActive ? 'active' : ''}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Sélecteur de langue -->
      <div class="lang-switcher">
        <a href={frPath} class={!isEn ? 'lang-active' : ''}>FR</a>
        <span class="lang-separator">|</span>
        <a href={enPath} class={isEn ? 'lang-active' : ''}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const navMenu = document.getElementById('nav-menu');

  toggleBtn?.addEventListener('click', () => {
    navMenu?.classList.toggle('is-open');
    toggleBtn.classList.toggle('is-active');
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--color-primary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: 80px;
    display: flex;
    align-items: center;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo-link img {
    height: 42px;
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-list {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-list a {
    color: var(--color-neutral);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .nav-list a:hover {
    color: var(--color-primary-extralight);
  }

  .nav-list a.active {
    color: var(--color-accent);
  }

  /* Sélecteur de langue */
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-neutral);
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: 16px;
  }

  .lang-switcher a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lang-switcher a:hover {
    color: var(--color-accent);
  }

  .lang-switcher a.lang-active {
    color: var(--color-accent);
  }

  .lang-separator {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Responsive Mobile */
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: 5px;
  }

  .bar {
    width: 24px;
    height: 2px;
    background-color: var(--color-neutral);
    transition: all 0.3s ease;
  }

  @media (max-width: 991px) {
    .menu-toggle {
      display: flex;
    }

    .nav {
      position: absolute;
      top: 80px;
      left: 0;
      width: 100%;
      background-color: var(--color-primary-dark);
      padding: 24px 0;
      display: none;
      flex-direction: column;
      box-shadow: 0 10px 15px rgba(0, 0, 0, 0.3);
    }

    .nav.is-open {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .lang-switcher {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-left: 0;
      padding-top: 16px;
      margin-top: 10px;
    }
  }
</style>