---
// src/pages/contact.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Contact - Sprauer Avocats Paris";
const pageDescription = "Contactez le cabinet Sprauer Avocats à Paris. Formulaire de contact, téléphone, adresse au 43 boulevard Haussmann et informations d'accès.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <!-- HERO SECTION -->
    <section class="hero">
      <svg class="hero-bg-svg" width="100%" height="100%" viewBox="0 0 296 255" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:space="preserve" xmlns:serif="http://www.serif.com/" style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;" data-astro-cid-lcdefpme=""><g transform="matrix(1,0,0,1,-946.441,-578.98)" data-astro-cid-lcdefpme=""><g data-astro-cid-lcdefpme=""><g transform="matrix(1.22997,3.01256e-16,-3.01256e-16,1.22997,-1250.69,-655.61)" data-astro-cid-lcdefpme=""><path d="M2016.36,1203.5C2016.98,1204.9 2019.25,1208.48 2026.39,1208.48L2026.39,1210.47L2018.74,1210.47L2018.74,1210.47L1951.36,1210.47L1951.36,1207.35L1956.05,1205.79C1960.42,1204.12 1963.07,1201.78 1964.01,1198.76C1964.95,1195.74 1964.79,1192.15 1963.54,1187.99L1915.45,1039.66L1895.33,1097.94C1893.72,1096.56 1892.06,1095.17 1890.33,1093.76L1912.22,1030.95L1912.71,1029.44L1921.64,1003.76L1921.7,1003.76L1948.24,1003.76L1991.35,1130.12L2016.36,1203.5Z" style="fill:white;" data-astro-cid-lcdefpme=""></path></g><g transform="matrix(1.22997,3.01256e-16,-3.01256e-16,1.22997,-1250.69,-655.61)" data-astro-cid-lcdefpme=""><path d="M1853.64,1152.17C1853.57,1152.03 1853.51,1151.89 1853.44,1151.75C1850.23,1145.2 1844.17,1138.04 1835.28,1130.27L1824.8,1121.87C1810.15,1110.08 1799.42,1098.15 1792.62,1086.07C1785.81,1074 1784.53,1060.04 1788.77,1044.2C1791.83,1032.8 1797.41,1023.74 1805.53,1017.01C1813.65,1010.28 1823.57,1006.11 1835.29,1004.49C1840.35,1003.79 1845.64,1003.59 1851.15,1003.9C1839.88,1008.82 1830.87,1018.63 1827.44,1031.43C1824.55,1042.2 1826.15,1053.14 1831.1,1062.23C1834.78,1069.28 1840.88,1076.34 1849.38,1083.43L1861.16,1092.79C1877.53,1105.88 1888.55,1118.09 1894.2,1129.44C1899.86,1140.79 1900.74,1153.71 1896.86,1168.2C1892.31,1185.2 1882.17,1197.34 1866.45,1204.62C1855.98,1209.47 1843.77,1211.3 1829.81,1210.12C1842.46,1205.71 1852.77,1195.32 1856.49,1181.43C1859.22,1171.26 1857.95,1160.95 1853.64,1152.17Z" style="fill:white;" data-astro-cid-lcdefpme=""></path></g><g transform="matrix(1.22997,3.01256e-16,-3.01256e-16,1.22997,-1237.25,-655.426)" data-astro-cid-lcdefpme=""><path d="M1786.28,1210.34L1786.3,1187.75L1809.66,1210.32L1786.28,1210.34Z" style="fill:white;" data-astro-cid-lcdefpme=""></path></g><g transform="matrix(-1.22997,-4.51884e-16,4.51884e-16,-1.22997,3263.48,2067.66)" data-astro-cid-lcdefpme=""><path d="M1786.28,1210.34L1786.3,1187.75L1809.66,1210.32L1786.28,1210.34Z" style="fill:white;" data-astro-cid-lcdefpme=""></path></g></g></g></svg>

      <div class="container hero-grid">
        <div class="hero-content">
          <h1>Contact</h1>
          <p>
            Have a question, need assistance, or want to schedule an appointment?<br />
            Sprauer Law Firm is here to help.<br /><br />
            You can contact us via the form below or by phone.
          </p>
        </div>
        <div class="hero-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/contact-hero.webp" 
            alt="Contact Sprauer Law Firm" 
            width="500" 
            height="500"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- FORM SECTION -->
    <section class="section-form">
      <div class="container container-narrow">
        <form class="contact-form" id="contactForm">
          <h2>CONTACT FORM</h2>

          <div class="form-fields">
            <div class="form-group">
              <label for="your-name">Full name <span class="required">*</span></label>
              <input 
                type="text" 
                id="your-name" 
                name="your-name" 
                placeholder="John Doe" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="your-email">Email <span class="required">*</span></label>
              <input 
                type="email" 
                id="your-email" 
                name="your-email" 
                placeholder="example@gmail.com" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="your-tel">Phone <span class="required">*</span></label>
              <input 
                type="tel" 
                id="your-tel" 
                name="your-tel" 
                placeholder="06 01 02 03 04" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="your-message">Your request <span class="required">*</span></label>
              <textarea 
                id="your-message" 
                name="your-message" 
                rows="5"
                placeholder="Describe your request here... (Please note that consultations are not free of charge)" 
                required
              ></textarea>
            </div>
          </div>

          <button type="submit" class="btn-submit">Submit</button>

          <!-- Success/error notification -->
          <div id="formStatus" class="form-status" style="display: none;"></div>

          <p class="rgpd-notice">
            By submitting this form, you agree that the information entered will be used to contact you.<br /><br />
            The information collected on this form is stored in a computerized file by <strong>Sprauer Law Firm</strong> for client management purposes. It is kept for 2 years and is intended for customer relations services located in the European Union.<br /><br />
            In accordance with data protection legislation, you may exercise your right to access and rectify your personal data by contacting <strong>Sprauer Law Firm</strong> by email at: <a href="mailto:cabinet@sprauer.fr">cabinet@sprauer.fr</a>
          </p>
        </form>
      </div>
    </section>

    <!-- MAP & PRACTICAL INFO SECTION -->
    <section class="section-map">
      <div class="container map-container">
        <!-- Information Overlay -->
        <div class="info-box">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/logo-h-blanc.webp" 
            alt="Sprauer Avocats" 
            class="info-logo"
            width="250"
          />
          
          <div class="info-list">
            <!-- Address -->
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zM7 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 2.88-2.88 7.19-5 9.88C9.92 16.21 7 11.85 7 9z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <p>43, boulevard Haussmann<br />75009 Paris</p>
            </div>

            <!-- Phone -->
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M6.54 5c.06.89.21 1.76.45 2.59l-1.2 1.2c-.41-1.2-.67-2.47-.76-3.79h1.51m9.86 12.02c.85.24 1.72.39 2.6.45v1.49c-1.32-.09-2.59-.35-3.8-.75l1.2-1.19M7.5 3H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1-1.24 0-2.45-.2-3.57-.57a.84.84 0 0 0-.31-.05c-.26 0-.51.1-.71.29l-2.2 2.2a15.149 15.149 0 0 1-6.59-6.59l2.2-2.2c.28-.28.36-.67.25-1.02A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1z"/></svg>
              <p><a href="tel:0140367487">01 40 36 74 87</a></p>
            </div>

            <!-- Email -->
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M12 1.95c-5.52 0-10 4.48-10 10s4.48 10 10 10h5v-2h-5c-4.34 0-8-3.66-8-8s3.66-8 8-8 8 3.66 8 8v1.43c0 .79-.71 1.57-1.5 1.57s-1.5-.78-1.5-1.57v-1.43c0-2.76-2.24-5-5-5s-5 2.24-5 5 2.24 5 5 5c1.38 0 2.64-.56 3.54-1.47.65.89 1.77 1.47 2.96 1.47 1.97 0 3.5-1.6 3.5-3.57v-1.43c0-5.52-4.48-10-10-10zm0 13c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"/></svg>
              <p><a href="mailto:cabinet@sprauer.fr">cabinet@sprauer.fr</a></p>
            </div>

            <!-- LinkedIn -->
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="icon"><path d="M 8.6425781 4 C 7.1835781 4 6 5.181625 6 6.640625 C 6 8.099625 7.182625 9.3085938 8.640625 9.3085938 C 10.098625 9.3085938 11.283203 8.099625 11.283203 6.640625 C 11.283203 5.182625 10.101578 4 8.6425781 4 z M 21.535156 11 C 19.316156 11 18.0465 12.160453 17.4375 13.314453 L 17.373047 13.314453 L 17.373047 11.310547 L 13 11.310547 L 13 26 L 17.556641 26 L 17.556641 18.728516 C 17.556641 16.812516 17.701266 14.960938 20.072266 14.960938 C 22.409266 14.960937 22.443359 17.145609 22.443359 18.849609 L 22.443359 26 L 26.994141 26 L 27 26 L 27 17.931641 C 27 13.983641 26.151156 11 21.535156 11 z M 6.3632812 11.310547 L 6.3632812 26 L 10.923828 26 L 10.923828 11.310547 L 6.3632812 11.310547 z"/></svg>
              <p><a href="https://fr.linkedin.com/in/vincent-sprauer-691022235" target="_blank" rel="noopener noreferrer">Sprauer Avocats</a></p>
            </div>

            <!-- Hours -->
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z"/></svg>
              <p>Monday to Friday from 9:30 AM to 8:30 PM, and Saturday by appointment</p>
            </div>

            <!-- Transport -->
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon"><circle cx="8.5" cy="14.5" r="1.5"/><circle cx="15.5" cy="14.5" r="1.5"/><path d="M12 2c-4 0-8 .5-8 4v9.5C4 17.43 5.57 19 7.5 19L6 20.5v.5h2l2-2h4l2 2h2v-.5L16.5 19c1.93 0 3.5-1.57 3.5-3.5V6c0-3.5-4-4-8-4zm0 2c3.51 0 4.96.48 5.57 1H6.43c.61-.52 2.06-1 5.57-1zM6 7h5v3H6V7zm12 8.5c0 .83-.67 1.5-1.5 1.5h-9c-.83 0-1.5-.67-1.5-1.5V12h12v3.5zm0-5.5h-5V7h5v3z"/></svg>
              <ul class="metro-list">
                <li>
                  <span class="badge m3">3</span>
                  <span class="station">Havre - Caumartin</span>
                </li>
                <li>
                  <span class="badge m7">7</span>
                  <span class="badge rer-a">A</span>
                  <span class="badge rer-e">E</span>
                  <span class="station">Auber</span>
                </li>
                <li>
                  <span class="badge m14">14</span>
                  <span class="station">Saint Lazare</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Google Maps Iframe -->
        <div class="map-wrapper">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.2100006991027!2d2.3270958769730674!3d48.87327309965823!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66fd575c97cfd%3A0x45ac96a783d9bdbc!2sSprauer%20Avocats!5e0!3m2!1sen!2skr!4v1789814440651!5m2!1sen!2skr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Gestion de la soumission du formulaire côté client
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const statusDiv = document.getElementById('formStatus');

  if (form && statusDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      statusDiv.style.display = 'block';
      statusDiv.className = 'form-status info';
      statusDiv.textContent = 'Envoi en cours...';

      const formData = new FormData(form);

      try {
        // Envoi vers l'API WordPress Form ou votre endpoint personnalisé
        const response = await fetch('https://front.sprauer.fr/wp-json/contact-form-7/v1/contact-forms/3167/feedback', {
          method: 'POST',
          body: formData
        });

        if (response.ok) {
          statusDiv.className = 'form-status success';
          statusDiv.innerHTML = '<strong>Votre message a été envoyé avec succès.</strong><br />Nous vous répondrons dans les plus brefs délais.';
          form.reset();
        } else {
          throw new Error('Erreur réseau');
        }
      } catch (err) {
        statusDiv.className = 'form-status error';
        statusDiv.textContent = 'Une erreur est survenue lors de l’envoi. Vous pouvez nous contacter directement par mail à cabinet@sprauer.fr';
      }
    });
  }
</script>

<style>
  /* HERO SECTION */
  .hero {
    position: relative;
    padding: 80px 0;
    background-color: var(--color-primary);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-content h1 {
    font-size: 2.6rem;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 20px 0;
  }

  .hero-content p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #ffffff;
  }

  .hero-image img {
    border-radius: 8px;
    object-fit: cover;
    width: 100%;
    height: auto;
    position: relative;
    z-index: 1;
  }

  /* SECTION FORMULAIRE */
  .section-form {
    position: relative;
    padding: 80px 0;
    background-color: var(--color-primary-light, #114080);
  }

  .container-narrow {
    max-width: 680px;
  }

  .contact-form {
    background-color: transparent;
    color: #ffffff;
  }

  .contact-form h2 {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-neutral, #f0ece8);
    margin-bottom: 30px;
    text-align: left;
  }

  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-neutral, #f0ece8);
  }

  .required {
    color: var(--color-accent);
    font-size: 1.2rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: 6px;
    border: 1px solid #ced4da;
    background-color: #ffffff;
    color: #000000;
    font-size: 0.95rem;
    outline: none;
    font-family: inherit;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(255, 170, 0, 0.25);
  }

  .btn-submit {
    margin-top: 25px;
    padding: 10px 32px;
    background-color: var(--color-primary-extralight, #72a6ee);
    color: var(--color-primary-dark, #06162f);
    font-size: 1.1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-submit:hover {
    background-color: var(--color-accent);
    color: var(--color-primary-dark, #06162f);
  }

  /* Statuts Formulaire */
  .form-status {
    margin-top: 20px;
    padding: 15px;
    border-radius: 6px;
    font-size: 0.95rem;
  }

  .form-status.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-status.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .form-status.info {
    background-color: #d1ecf1;
    color: #0c5460;
  }

  .rgpd-notice {
    margin-top: 30px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-neutral, #f0ece8);
  }

  .rgpd-notice a {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: underline;
  }

  /* MAP SECTION */
  .section-map {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .map-container {
    position: relative;
    max-width: 100%;
    padding: 0;
  }

  .map-wrapper iframe {
    width: 100%;
    height: 650px;
    border: none;
    display: block;
  }

  /* INFOS OVERLAY BOX */
  .info-box {
    position: absolute;
    top: 40px;
    right: 5%;
    z-index: 10;
    width: 420px;
    background-color: var(--color-primary);
    border-radius: 10px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    color: #ffffff;
  }

  .info-logo {
    width: 220px;
    height: auto;
    margin-bottom: 25px;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
  }

  .info-item .icon {
    width: 24px;
    height: 24px;
    fill: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-item p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-neutral, #f0ece8);
  }

  .info-item a {
    color: var(--color-neutral, #f0ece8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-item a:hover {
    color: var(--color-accent);
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 991px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .info-box {
      position: relative;
      top: 0;
      right: 0;
      width: 100%;
      border-radius: 0;
      box-shadow: none;
    }

    .map-wrapper iframe {
      height: 450px;
    }
  }

  @media (max-width: 575px) {
    .hero {
      padding: 50px 0;
    }

    .section-form {
      padding: 50px 0;
    }

    .info-box {
      padding: 25px 20px;
    }
  }

  /* Structure de la liste */
.metro-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.metro-list li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.95rem;
}

/* Style de base des pastilles rondes */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  font-weight: 700;
  font-size: 0.85rem;
  line-height: 1;
  flex-shrink: 0;
}

/* Couleurs officielles RATP */
.badge.m3 { background-color: #9b983b; color: #ffffff; }
.badge.m7 { background-color: #f59fb3; color: #000000; } /* Fond clair = texte noir */
.badge.m14 { background-color: #662483; color: #ffffff; }
.badge.rer-a { background-color: #e3051c; color: #ffffff; }
.badge.rer-e { background-color: #de82b5; color: #ffffff; }
</style>