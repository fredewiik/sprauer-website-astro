---
// src/pages/vos-avocats.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// URL de base pour la version anglaise
const enBaseUrl = `${baseUrl}en/`;

const pageTitle = "Vos avocats - Sprauer Avocats Paris";
const pageDescription = "Les associés du cabinet mettent leur expertise et leur engagement au service de la défense de vos intérêts en droit des affaires et droit pénal.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <!-- HERO SECTION -->
    <section class="hero">
      <svg class="hero-bg-svg" width="100%" height="100%" viewBox="0 0 296 255" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:space="preserve" xmlns:serif="http://www.serif.com/" style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;">
          <g transform="matrix(1,0,0,1,-946.441,-578.98)">
              <g>
                  <g transform="matrix(1.22997,3.01256e-16,-3.01256e-16,1.22997,-1250.69,-655.61)">
                      <path d="M2016.36,1203.5C2016.98,1204.9 2019.25,1208.48 2026.39,1208.48L2026.39,1210.47L2018.74,1210.47L2018.74,1210.47L1951.36,1210.47L1951.36,1207.35L1956.05,1205.79C1960.42,1204.12 1963.07,1201.78 1964.01,1198.76C1964.95,1195.74 1964.79,1192.15 1963.54,1187.99L1915.45,1039.66L1895.33,1097.94C1893.72,1096.56 1892.06,1095.17 1890.33,1093.76L1912.22,1030.95L1912.71,1029.44L1921.64,1003.76L1921.7,1003.76L1948.24,1003.76L1991.35,1130.12L2016.36,1203.5Z" style="fill:white;"></path>
                  </g>
                  <g transform="matrix(1.22997,3.01256e-16,-3.01256e-16,1.22997,-1250.69,-655.61)">
                      <path d="M1853.64,1152.17C1853.57,1152.03 1853.51,1151.89 1853.44,1151.75C1850.23,1145.2 1844.17,1138.04 1835.28,1130.27L1824.8,1121.87C1810.15,1110.08 1799.42,1098.15 1792.62,1086.07C1785.81,1074 1784.53,1060.04 1788.77,1044.2C1791.83,1032.8 1797.41,1023.74 1805.53,1017.01C1813.65,1010.28 1823.57,1006.11 1835.29,1004.49C1840.35,1003.79 1845.64,1003.59 1851.15,1003.9C1839.88,1008.82 1830.87,1018.63 1827.44,1031.43C1824.55,1042.2 1826.15,1053.14 1831.1,1062.23C1834.78,1069.28 1840.88,1076.34 1849.38,1083.43L1861.16,1092.79C1877.53,1105.88 1888.55,1118.09 1894.2,1129.44C1899.86,1140.79 1900.74,1153.71 1896.86,1168.2C1892.31,1185.2 1882.17,1197.34 1866.45,1204.62C1855.98,1209.47 1843.77,1211.3 1829.81,1210.12C1842.46,1205.71 1852.77,1195.32 1856.49,1181.43C1859.22,1171.26 1857.95,1160.95 1853.64,1152.17Z" style="fill:white;"></path>
                  </g>
                  <g transform="matrix(1.22997,3.01256e-16,-3.01256e-16,1.22997,-1237.25,-655.426)">
                      <path d="M1786.28,1210.34L1786.3,1187.75L1809.66,1210.32L1786.28,1210.34Z" style="fill:white;"></path>
                  </g>
                  <g transform="matrix(-1.22997,-4.51884e-16,4.51884e-16,-1.22997,3263.48,2067.66)">
                      <path d="M1786.28,1210.34L1786.3,1187.75L1809.66,1210.32L1786.28,1210.34Z" style="fill:white;"></path>
                  </g>
              </g>
          </g>
      </svg>

      <div class="container hero-grid">
        <div class="hero-content">
          <h1><span>Your</span> Lawyers</h1>
          <p>
            The firm's partners put their expertise and commitment at the service of defending your interests.<br /><br />
            Each of them practices in complex legal fields requiring rigor, responsiveness, and excellence, in keeping with the firm's values.
          </p>
        </div>
        <div class="hero-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/justice-2060093.webp" 
            alt="Statue of Justice" 
            width="700" 
            height="700"
          />
        </div>
      </div>
    </section>

    <!-- VINCENT SPRAUER SECTION -->
    <section class="lawyer-section vincent" id="vincent-sprauer">
      <div class="container lawyer-grid">
        <div class="lawyer-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/vincent-sprauer.webp" 
            alt="Maître Vincent Sprauer - Lawyer in Paris" 
            width="500" 
            height="750"
          />
        </div>

        <svg class="svg-triangle" xmlns="http://www.w3.org/2000/svg" viewBox="178.5 225.62648010253906 425 189.37351989746094" data-viewbox="" data-zoom="1" style="overflow: visible;"><g><polygon stroke="rgba(255, 255, 255, 0)" stroke-width="1" fill="var(--dpntalel)" points="395.1023254394531, 235.62648010253906 593.5, 405 188.5, 405"></polygon></g></svg>

        <svg class="svg-deco" width="874" height="874" viewBox="0 0 874 874" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="421" height="421" fill="#0A244A" fill-opacity="0.05"></rect>
          <rect x="453" y="453" width="421" height="421" fill="#0A244A" fill-opacity="0.05"></rect>
          <path d="M448.016 6.31779L868.542 426.843V427.43H447.429V6.31779H448.016Z" fill="#0A244A" fill-opacity="0.05"></path>
          <path d="M426.57 868.269L6.04324 447.742L6.04324 447.156L427.156 447.156L427.156 868.269L426.57 868.269Z" fill="#0A244A" fill-opacity="0.05"></path>
        </svg>

        <div class="lawyer-content">
          <div class="lawyer-title">
            <span class="triangle-icon">▲</span>
            <h2>Vincent <span>Sprauer</span></h2>
          </div>
          <p class="subtitle">Attorney registered at the Paris Bar.</p>
          <div class="bio">
            <p>
              With dual expertise in private law and applied foreign languages, Maître SPRAUER graduated from Paris 1 Panthéon-Sorbonne University.
            </p>
            <p>
              Since 2019, he has built solid experience within renowned Parisian law firms, distinguishing himself in complex cases in criminal law and business law.
            </p>
            <p>
              His expertise extends to defending accounting professionals and supporting a diverse clientele in civil, commercial, and criminal matters.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- MÉLANIE MIROITE SECTION -->
    <section class="lawyer-section melanie" id="melanie-miroite">
      <div class="container lawyer-grid reverse">
        <div class="lawyer-image">
          <img 
            src="https://front.sprauer.fr/wp-content/uploads/2025/08/melanie-miroite.webp" 
            alt="Maître Mélanie Miroite - Lawyer in Paris" 
            width="500" 
            height="750"
          />
        </div>

        <svg class="svg-triangle2" xmlns="http://www.w3.org/2000/svg" viewBox="178.5 225.62648010253906 425 189.37351989746094" data-viewbox="" data-zoom="1" style="overflow: visible;"><g><polygon stroke="rgba(255, 255, 255, 0)" stroke-width="1" fill="var(--dp5u7bvo)" points="395.1023254394531, 235.62648010253906 593.5, 405 188.5, 405"></polygon></g></svg>

        <svg class="svg-deco2" width="874" height="874" viewBox="0 0 874 874" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="421" height="421" fill="#0A244A" fill-opacity="0.05"></rect>
          <rect x="453" y="453" width="421" height="421" fill="#0A244A" fill-opacity="0.05"></rect>
          <path d="M448.016 6.31779L868.542 426.843V427.43H447.429V6.31779H448.016Z" fill="#0A244A" fill-opacity="0.05"></path>
          <path d="M426.57 868.269L6.04324 447.742L6.04324 447.156L427.156 447.156L427.156 868.269L426.57 868.269Z" fill="#0A244A" fill-opacity="0.05"></path>
        </svg>

        <div class="lawyer-content">
          <div class="lawyer-title">
            <span class="triangle-icon">▲</span>
            <h2>Mélanie Miroite</h2>
          </div>
          <p class="subtitle">Attorney registered at the Paris Bar.</p>
          <div class="bio">
            <p>
              Holding a Master 2 degree in Civil and Commercial Obligations Law from Paris Descartes University, Maître MIROITE has over the years acquired specialized knowledge in asylum law and immigration law.
            </p>
            <p>
              Today, Maître MIROITE pleads daily before the National Court of Asylum located in MONTREUIL, enabling her to provide her clients with optimal counsel regarding the procedure and specific expectations of this jurisdiction.
            </p>
            <p>
              Maître MIROITE is also actively involved in community organizations assisting with the welcoming and integration of foreign nationals in France.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* HERO SECTION */
  .hero {
    position: relative;
    padding: 80px 0;
    background-color: var(--color-primary);
  }

  .hero-grid {
    position: relative;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-content h1 {
    font-size: 2.6rem;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1.1;
  }

  .hero-content h1 span {
    color: var(--color-accent);
  }

  .hero-content p {
    margin-top: 20px;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .hero-image img {
    border-radius: 8px;
    object-fit: contain;
    width: 100%;
    height: auto;
  }

  /* SECTIONS AVOCATS */
  .svg-deco {
    position: absolute;
    width: 42em;
    height: auto;
    min-width: 0px;
    inset: 0% 0% auto auto;
  }

  .svg-deco2 {
    position: absolute;
    width: 42em;
    height: auto;
    min-width: 0px;
    inset: auto auto auto 0%;
  }

  .svg-triangle {
    position: absolute;
    width: 30em;
    height: 20em;
    min-width: 0px;
    min-height: 0px;
    transform: rotateX(0deg) rotateY(0deg) rotateZ(90deg);
    z-index: 0;
    inset: 25% auto auto -2%;
    fill: var(--color-accent);
  }

  .svg-triangle2 {
    position: absolute;
    width: 30em;
    height: 20em;
    min-width: 0px;
    min-height: 0px;
    transform: rotateX(0deg) rotateY(0deg) rotateZ(-90deg);
    z-index: 0;
    background-image: none;
    color: var(--dp5u7bvo);
    fill: var(--dp5u7bvo);
    inset: 25% -15% auto auto;
  }

  .lawyer-section {
    padding: 90px 0;
    overflow: hidden;
  }

  .lawyer-section.vincent {
    background-color: var(--color-neutral);
    color: var(--color-primary);
  }

  .lawyer-section.melanie {
    background-color: var(--color-primary-extralight);
    color: var(--color-primary);
  }

  .lawyer-grid {
    position: relative;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  .lawyer-grid.reverse {
    flex-direction: row-reverse;
  }

  .lawyer-image {
    position: relative;
    z-index: 1;
    flex: 1;
    max-width: 440px;
  }

  .lawyer-image img {
    width: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .lawyer-content {
    flex: 1.2;
  }

  .lawyer-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .lawyer-title h2 {
    font-size: 2.25rem;
    font-weight: 600;
  }

  .triangle-icon {
    color: var(--color-accent);
    font-size: 0.8rem;
    transform: rotate(90deg);
  }

  .melanie .triangle-icon {
    color: var(--color-primary);
  }

  .subtitle {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 20px;
  }

  .bio p {
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .bio p:last-child {
    margin-bottom: 0;
  }

  /* RESPONSIVE TABLETTE & MOBILE */
  @media (max-width: 991px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .lawyer-grid,
    .lawyer-grid.reverse {
      flex-direction: column;
      text-align: center;
      gap: 40px;
    }

    .lawyer-image {
      max-width: 100%;
    }

    .lawyer-title {
      justify-content: center;
    }
  }

  @media (max-width: 575px) {
    .hero {
      padding: 50px 0;
    }

    .lawyer-section {
      padding: 60px 0;
    }

    .hero-content h1 {
      font-size: 2rem;
    }

    .lawyer-title h2 {
      font-size: 1.8rem;
    }

    .svg-triangle {
      inset: 9% auto auto -10%;
    }

    .svg-triangle2, .svg-deco2 {
      inset: 20% auto auto 30%;
    }

    .svg-deco {
      display: none;
    }
  }
</style>