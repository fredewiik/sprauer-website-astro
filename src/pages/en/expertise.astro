---
// src/pages/competences.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Compétences - Sprauer Avocats Paris";
const pageDescription = "Découvrez l'ensemble des expertises du cabinet Sprauer Avocats à Paris : droit pénal, droit pénal des affaires et droit des affaires.";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// URL de base pour la version anglaise
const enBaseUrl = `${baseUrl}en/`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="site-main">
    <!-- HERO SECTION -->
    <section class="hero-section" id="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
            <h1 class="hero-title">All our <strong class="hero-title-accent">areas of expertise</strong></h1>
            <div class="hero-text-wrapper">
              <p class="hero-text">
                Specializing in criminal law, white-collar crime, and business law, the firm puts its expertise at the service of your most sensitive legal issues.
                <br /><br />
                We support you with rigor, confidentiality, and efficiency in each area of practice presented here.
              </p>
            </div>
          </div>
          <div class="hero-img-container">
            <img
              class="hero-img"
              src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-matreding-30241270.webp"
              alt="pexels-matreding-30241270"
              srcset="https://sprauer.fr/wp-content/uploads/2025/08/pexels-matreding-30241270-300x300.webp 300w, https://sprauer.fr/wp-content/uploads/2025/08/pexels-matreding-30241270-150x150.webp 150w, https://sprauer.fr/wp-content/uploads/2025/08/pexels-matreding-30241270.webp 700w"
              sizes="(max-width: 700px) 100vw, 700px"
              loading="lazy"
            />
          </div>
        </div>
      </div>
      <svg class="hero-bg-svg" width="100%" height="100%" viewBox="0 0 296 255" version="1.1" xmlns="http://www.w3.org/2000/svg">
        <g transform="matrix(1,0,0,1,-946.441,-578.98)">
          <g>
            <g transform="matrix(1.22997,0,0,1.22997,-1250.69,-655.61)">
              <path d="M2016.36,1203.5C2016.98,1204.9 2019.25,1208.48 2026.39,1208.48L2026.39,1210.47L2018.74,1210.47L2018.74,1210.47L1951.36,1210.47L1951.36,1207.35L1956.05,1205.79C1960.42,1204.12 1963.07,1201.78 1964.01,1198.76C1964.95,1195.74 1964.79,1192.15 1963.54,1187.99L1915.45,1039.66L1895.33,1097.94C1893.72,1096.56 1892.06,1095.17 1890.33,1093.76L1912.22,1030.95L1912.71,1029.44L1921.64,1003.76L1921.7,1003.76L1948.24,1003.76L1991.35,1130.12L2016.36,1203.5Z" style="fill:white;"></path>
            </g>
            <g transform="matrix(1.22997,0,0,1.22997,-1250.69,-655.61)">
              <path d="M1853.64,1152.17C1853.57,1152.03 1853.51,1151.89 1853.44,1151.75C1850.23,1145.2 1844.17,1138.04 1835.28,1130.27L1824.8,1121.87C1810.15,1110.08 1799.42,1098.15 1792.62,1086.07C1785.81,1074 1784.53,1060.04 1788.77,1044.2C1791.83,1032.8 1797.41,1023.74 1805.53,1017.01C1813.65,1010.28 1823.57,1006.11 1835.29,1004.49C1840.35,1003.79 1845.64,1003.59 1851.15,1003.9C1839.88,1008.82 1830.87,1018.63 1827.44,1031.43C1824.55,1042.2 1826.15,1053.14 1831.1,1062.23C1834.78,1069.28 1840.88,1076.34 1849.38,1083.43L1861.16,1092.79C1877.53,1105.88 1888.55,1118.09 1894.2,1129.44C1899.86,1140.79 1900.74,1153.71 1896.86,1168.2C1892.31,1185.2 1882.17,1197.34 1866.45,1204.62C1855.98,1209.47 1843.77,1211.3 1829.81,1210.12C1842.46,1205.71 1852.77,1195.32 1856.49,1181.43C1859.22,1171.26 1857.95,1160.95 1853.64,1152.17Z" style="fill:white;"></path>
            </g>
            <g transform="matrix(1.22997,0,0,1.22997,-1237.25,-655.426)">
              <path d="M1786.28,1210.34L1786.3,1187.75L1809.66,1210.32L1786.28,1210.34Z" style="fill:white;"></path>
            </g>
            <g transform="matrix(-1.22997,0,0,-1.22997,3263.48,2067.66)">
              <path d="M1786.28,1210.34L1786.3,1187.75L1809.66,1210.32L1786.28,1210.34Z" style="fill:white;"></path>
            </g>
          </g>
        </g>
      </svg>
    </section>

    <!-- Criminal Law Section -->
    <section class="section-penal" id="section-droit-penal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title text-neutral">Criminal law</h2>
        </div>
        <div class="grid-layout">
          <div class="card card-penal-1">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-alex-qian-1180283-2325886.webp" alt="Dismissal of complaint" loading="lazy" />
            <div class="card-content">
              <h3 class="card-title text-neutral">Dismissal of complaint</h3>
              <a class="card-btn btn-neutral" href={`${enBaseUrl}expertise/plainte-classee-sans-suite/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-2">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-karatara-278139-931317.webp" alt="Indictment" loading="lazy" />
            <div class="card-content">
              <h3 class="card-title text-neutral">Indictment</h3>
              <a class="card-btn btn-neutral" href={`${enBaseUrl}expertise/mise-en-examen/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-3">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-ekaterina-bolovtsova-6077123.webp" alt="Immediate appearance" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Immediate appearance</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/comparution-immediate/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-4">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-fred-18978472.webp" alt="Appearance upon prior recognition of guilt" height="400" />
            <div class="card-content">
              <h3 class="card-title text-white">Appearance upon prior recognition of guilt</h3>
              <a class="card-btn btn-neutral" href={`${enBaseUrl}expertise/crpc/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-5">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-bingqian-li-230971044-31589565.webp" alt="Police custody" loading="lazy" />
            <div class="card-content text-primary">
              <h1 class="card-title-lg">Police custody</h1>
              <a class="card-btn" href={`${enBaseUrl}expertise/police-custody/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-6">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-scarlett-boute-144979497-11679719.webp" alt="TAJ & B2 record erasure" loading="lazy" />
            <div class="card-content text-accent">
              <h3 class="card-title">TAJ &amp; B2 record erasure</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/effacement-taj-b2/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-7">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-azamat-hatypov-97167739-31612532.webp" alt="Police custody" loading="lazy" />
            <div class="card-content">
              <h1 class="card-title text-white">Police custody</h1>
              <a class="card-btn btn-white" href={`${enBaseUrl}expertise/police-custody/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-8">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-tattoodonor-tattoodonor-1160289080-25942440.webp" alt="Pre-trial detention" loading="lazy" />
            <div class="card-content">
              <h1 class="card-title">Pre-trial detention</h1>
              <a class="card-btn btn-primary" href={`${enBaseUrl}expertise/detention-provisoire/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-penal-9">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-francois-hanscotte-3537774-5292296-1.webp" alt="Police custody" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Police custody</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/police-custody/`}><span>Learn more</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- White-Collar Crime Section -->
    <section class="section-affaires-penal" id="section-droit-penal-des-affaires">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title text-white">White-collar crime</h2>
        </div>
        <div class="grid-layout">
          <div class="card card-affaires-p-1">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-claudio-mota-105200226-9999874.webp" alt="Compliance" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Compliance</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/compliance/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-2">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-tom-pursey-3025008-4693103.webp" alt="Deceptive commercial practices" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Deceptive commercial practices</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/pratiques-commerciales-trompeuses/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-3">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-lucaspcarlini-15097854.webp" alt="Fraud and money laundering" loading="lazy" />
            <div class="card-content">
              <h3 class="card-title text-extralight">Fraud and money laundering</h3>
              <a class="card-btn btn-blue" href={`${enBaseUrl}expertise/escroquerie-et-blanchiment/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-4">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-lindseygarrett-13987195.webp" alt="Criminal liability" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Criminal and professional liability of chartered accountants</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/responsabilite-penale-experts-comptables/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-5">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-bingqian-li-230971044-31589565.webp" alt="Police custody" loading="lazy" />
            <div class="card-content text-primary">
              <h1 class="card-title-lg">Police custody</h1>
              <a class="card-btn" href={`${enBaseUrl}expertise/police-custody/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-6">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-radubradu-395822838-16292110.webp" alt="Misuse of corporate assets" loading="lazy" />
            <div class="card-content text-accent">
              <h3 class="card-title">Misuse of corporate assets</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/abus-de-biens-sociaux/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-7">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-wondererphotograph-2564066.webp" alt="Tax fraud and tax optimization" loading="lazy" />
            <div class="card-content">
              <h1 class="card-title text-dark">Tax fraud and tax optimization</h1>
              <a class="card-btn btn-primary" href={`${enBaseUrl}expertise/fraude-et-optimisation-fiscale/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-8">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-mel-jlt-1582232815-27625129.webp" alt="Criminal liability" loading="lazy" />
            <div class="card-content">
              <h1 class="card-title">Criminal and professional liability of statutory auditors</h1>
              <a class="card-btn" href={`${enBaseUrl}expertise/responsabilite-penale-commissaires-aux-comptes/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-p-9">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-tbd-traveller-2149583744-30718760.webp" alt="Criminal liability of executives" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Criminal liability of company executives</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/responsabilite-penale-du-dirigeant/`}><span>Learn more</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Business Law Section -->
    <section class="section-affaires" id="section-droit-des-affaires">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title text-neutral">Business law</h2>
        </div>
        <div class="grid-layout">
          <div class="card card-affaires-1">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-lomarie-loreine-aipar-2148255682-31583577.webp" alt="Corporate law" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Corporate law</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/droit-des-societes/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-2">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-jeffrey-czum-254391-2733955.webp" alt="Commercial contracts" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Commercial contracts</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/contrats-commerciaux/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-3">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-celine-3776818-15190885.webp" alt="Commercial litigation" loading="lazy" />
            <div class="card-content text-primary">
              <h3 class="card-title">Commercial litigation</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/contentieux-commercial/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-4">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-zacharie-elbaz-1911751498-31589387.webp" alt="Distressed companies" loading="lazy" />
            <div class="card-content">
              <h3 class="card-title text-extralight">Distressed companies</h3>
              <a class="card-btn btn-neutral" href={`${enBaseUrl}expertise/entreprises-en-difficulte/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-5">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-bingqian-li-230971044-31589565.webp" alt="Commercial leases" loading="lazy" />
            <div class="card-content text-primary">
              <h1 class="card-title-lg">Commercial leases</h1>
              <a class="card-btn" href={`${enBaseUrl}expertise/baux-commerciaux/`}><span>Learn more</span></a>
            </div>
          </div>
          <div class="card card-affaires-6">
            <img class="card-img" src="https://front.sprauer.fr/wp-content/uploads/2025/08/pexels-emily-252615-768125.webp" alt="Unfair competition" loading="lazy" />
            <div class="card-content text-accent">
              <h3 class="card-title">Unfair competition</h3>
              <a class="card-btn" href={`${enBaseUrl}expertise/concurrence-deloyale/`}><span>Learn more</span></a>
            </div>
          </div>
