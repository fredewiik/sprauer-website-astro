</BaseLayout>

<style is:global>
  /* Header */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    background-color: var(--color-primary);
    z-index: 100;
  }
  .header-container { max-width: 1216px; margin: 0 auto; padding: 8px 20px; }
  .header-inner { display: flex; justify-content: space-between; align-items: center; height: 64px; }
  .logo-wrapper { width: 50%; display: flex; align-items: center; }
  .logo-img { height: 55px; width: auto; }
  .nav-menu { display: flex; justify-content: flex-end; align-items: center; width: 100%; }
  .nav-list { display: flex; gap: 40px; list-style: none; margin: 0; padding: 0; }
  .nav-link { color: #fff; font-size: 14px; text-transform: uppercase; text-decoration: none; font-family: var(--font-main); }
  .nav-link.active { color: var(--color-accent); font-weight: 500; }

  /* Hero */
  .hero-section {
    position: relative;
    z-index: 1;
    background-color: var(--color-primary);
    overflow: hidden;
    padding: 100px 0;
    margin-top: 23px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(75px, 1fr);
    column-gap: 40px;
    row-gap: 40px;
    align-items: center;
  }
  .hero-content { display: flex; flex-direction: column; row-gap: 40px; }
  .hero-title { font-size: 42px; font-weight: 600; text-transform: uppercase; color: var(--color-neutral); font-family: var(--font-main); }
  .hero-title-accent { color: var(--color-accent); font-weight: 600; }
  .hero-text-wrapper { margin-top: 20px; }
  .hero-text { font-size: 18px; line-height: 1.5em; color: #fff; font-family: var(--font-main); }
  .hero-img-container { overflow: hidden; border-radius: 8px; width: 100%; }
  .hero-img { max-width: 100%; height: auto; display: block; }
  .hero-bg-svg { position: absolute; width: 100%; height: 150%; opacity: 0.07; z-index: -100; inset: 5% auto auto 0%; }

  /* Base Sections */
  #section-droit-penal h2 { color: black; }
  .section-penal { position: relative; z-index: 1; background-color: white; padding: 100px 0; }
  .section-affaires-penal { position: relative; z-index: 1; background-color: var(--color-primary-light); padding: 100px 0; }
  .section-affaires { position: relative; z-index: 1; background-color: var(--color-primary); padding: 100px 0; }

  .section-header { margin-bottom: 60px; }
  .section-title { font-size: 32px; font-weight: 400; line-height: 1.2em; font-family: var(--font-main); margin: 0; }

  /* Grid Layout Global */
  .grid-layout {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    column-gap: 10px;
    row-gap: 10px;
    grid-template-rows: minmax(75px,1fr) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto) minmax(75px, auto);
  }

  .card { display: flex; padding: 0; color: var(--color-primary); }
  .card-img { width: auto; height: auto; object-fit: cover; }
  .card-content { text-align: center; padding: 10px; width: 100%; flex-grow: 1; align-content: center; }
  .card-title { font-family: var(--font-main); font-weight: 400; font-size: 1.15rem; margin: 10px; }
  .card-title-lg { font-family: var(--font-main); font-weight: 400; font-size: 1.25rem; margin: 10px; }
